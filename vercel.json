{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/pagar",
      "destination": "/"
    },
    {
      "source": "/factura",
      "destination": "/"
    },
    {
      "source": "/producto/:cod",
      "destination": "/api/pagina?cod=:cod"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/pagina?tipo=sitemap"
    }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/pagina.js": {
      "includeFiles": "plantilla.html"
    }
  }
}
