# Variables de entorno del proyecto. Para pruebas locales (npm run dev), copia este archivo como .env.

# Dirección pública del sitio (para el sitemap y las etiquetas de Google)
SITE_URL=https://tu-proyecto.vercel.app

# PayPal Sandbox → developer.paypal.com → Apps & Credentials → Sandbox → tu app
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Supabase → Project Settings → API: URL del proyecto y clave secreta (secret / service_role). Nunca la expongas en el navegador.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Correo(s) que pueden entrar al panel /admin (separados por comas). El usuario se crea en Supabase → Authentication → Users.
ADMIN_EMAILS=

# Gmail que envía las facturas (necesita verificación en 2 pasos y una "contraseña de aplicación")
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Opcional: recibe una copia oculta de cada factura (por ejemplo, el correo del profesor o el tuyo)
COPIA_FACTURAS=

# Solo para pruebas locales: arma el correo con el PDF pero no lo envía
# CORREO_MODO=prueba
